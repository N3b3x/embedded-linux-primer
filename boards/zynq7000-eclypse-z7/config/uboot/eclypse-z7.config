# U-Boot configuration fragment, merged on top of xilinx_zynq_virt_defconfig
# (see scripts/uboot.sh and docs/03-uboot-spl.md). scripts/uboot.sh adds one more line,
# CONFIG_XILINX_PS_INIT_FILE, pointing at the ps7_init_gpl.c it prepared.
#
# The board device tree (custom/dts/zynq-eclypse-z7.dts), used by SPL and by U-Boot proper.
CONFIG_DEFAULT_DEVICE_TREE="zynq-eclypse-z7"
CONFIG_OF_LIST="zynq-eclypse-z7"
# Show which U-Boot this is.
CONFIG_LOCALVERSION="-eclypse-z7"

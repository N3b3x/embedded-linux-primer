    "jetson-orin-nano": {
      "title": "NVIDIA Jetson Orin Nano Developer Kit",
      "short": "Jetson Orin Nano",
      "dir": "boards/jetson-orin-nano",
      "enabled": true,
      "flashing_model": "vendor-flash",

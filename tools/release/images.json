          "stage": "jetson-kernel",
          "title": "Kernel bundle: Image, modules and device trees (no NVIDIA BSP, no root filesystem)",
          "build": [
            "./build.sh --yes fetch bsp",
            "./build.sh --yes fetch sources",
            "./build.sh --yes fetch toolchain",
            "./build.sh --yes kernel extract config build"
          ],
          "deploy": [
            {
              "src": "@bundle",
              "name": "jetson-orin-nano-kernel.tar.xz",
              "compress": "none",
              "role": "bundle"
            }
          ],
          "approx_size_mb": 140,
          "approx_raw_size_mb": 700,
          "size_is_estimate": true,
          "redistribution": "Only what NVIDIA's public sources build: the Linux kernel, in-tree and NVIDIA out-of-tree modules and device trees, under the licences in each source file. NVIDIA's Jetson Linux driver package (board support package), flash tools, firmware and sample root filesystem are NOT included: NVIDIA's Tegra Software License Agreement allows distributing its software only in the cases of clause 1.1 and otherwise forbids it (clause 2.7), and whether a flash package qualifies is for legal to decide. Each person downloads those from NVIDIA with ./build.sh fetch.",
          "licence_ids": [
            "gpl-kernel-bootloader",
            "nvidia-public-sources"
          ],
          "runner": {
            "disk_gb": 30,
            "minutes": 90,
            "arch": "x86_64",
            "standard_runner": true,
            "needs": [
              "x86-64 runner (NVIDIA's reference compiler is an x86-64 program)",
              "NVIDIA download servers reachable (about 1 GB of downloads: driver package, public sources, toolchain)"
            ]
          }
        },
        "flash-package": {
          "enabled": false,
          "disabled_reason": "Not published: it contains NVIDIA's board support package and a root filesystem modified by NVIDIA's tools (redistribution is a question for legal), needs sudo/loop mounts and about 40-60 GB. Build it locally with ./build.sh all.",
          "kind": "not-published",
          "title": "Full flash package (Linux_for_Tegra)",
          "build": [
            "./build.sh --yes --accept-license all"
          ],
          "deploy": [],
          "approx_size_mb": 0,
          "redistribution": "Not redistributed (NVIDIA licence terms: for legal to decide; also too large for a standard runner).",
          "licence_ids": [
            "nvidia-bsp"
          ],
          "runner": {
            "disk_gb": 60,
            "minutes": 180,
            "arch": "x86_64",
            "standard_runner": false,
            "needs": [

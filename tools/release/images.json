{
  "schema": 1,
  "repo": "N3b3x/embedded-linux-primer",
  "pages": "https://n3b3x.github.io/embedded-linux-primer",
  "compression": {
    "xz": "xz -T1 -6 (single thread, fixed level): the multi-threaded and single-threaded encoders produce different bytes, so one thread keeps the output a pure function of the input and the xz version"
  },
  "boards": {
    "imx8mp-variscite": {
      "title": "i.MX 8M Plus (Variscite DART, VAR-SOM, VAR-SMARC)",
      "short": "i.MX 8M Plus",
      "dir": "boards/imx8mp-variscite",
      "enabled": true,
      "flashing_model": "sd-card",
      "repro": {
        "commands": [
          "./build.sh --yes --accept-eula uboot"
        ],
        "outputs": [
          "imx-boot.bin"
        ]
      },
      "readme": "boards/imx8mp-variscite/README.md",
      "docs": "boards/imx8mp-variscite/docs/07-flashing-and-boot.md",
      "variants": {
        "debian": {
          "enabled": true,
          "kind": "sdcard",
          "title": "SD-card image, Debian 13 root filesystem",
          "build": [
            "./build.sh --yes --accept-eula -r debian all"
          ],
          "deploy": [
            {
              "src": "sdcard.img",
              "name": "imx8mp-variscite-debian.img",
              "compress": "xz",
              "role": "image"
            },
            {
              "src": "sdcard.img.bmap",
              "name": "imx8mp-variscite-debian.img.bmap",
              "compress": "none",
              "role": "bmap",
              "optional": true
            }
          ],
          "approx_size_mb": 600,
          "approx_raw_size_mb": 3500,
          "size_is_estimate": true,
          "redistribution": "Contains NXP DDR training firmware (firmware-imx, NXP software licence agreement, accepted at build time with --accept-eula) and Debian packages under their own licences. Not for redistribution until the licence questions are settled: see docs/image-licences.md.",
          "licence_ids": [
            "nxp-firmware-imx",
            "gpl-kernel-bootloader",
            "debian-packages"
          ],
          "runner": {
            "disk_gb": 25,
            "minutes": 60,
            "arch": "x86_64",
            "standard_runner": true,
            "needs": [
              "qemu-user-static (arm64 rootfs)",
              "user namespaces for rootless mmdebstrap"
            ]
          }
        },
        "alpine": {
          "enabled": true,
          "kind": "sdcard",
          "title": "SD-card image, Alpine 3.24 root filesystem",
          "build": [
            "./build.sh --yes --accept-eula -r alpine all"
          ],
          "deploy": [
            {
              "src": "sdcard.img",
              "name": "imx8mp-variscite-alpine.img",
              "compress": "xz",
              "role": "image"
            },
            {
              "src": "sdcard.img.bmap",
              "name": "imx8mp-variscite-alpine.img.bmap",
              "compress": "none",
              "role": "bmap",
              "optional": true
            }
          ],
          "approx_size_mb": 200,
          "approx_raw_size_mb": 1500,
          "size_is_estimate": true,
          "redistribution": "Contains NXP DDR training firmware (firmware-imx, NXP software licence agreement, accepted at build time with --accept-eula) and Alpine packages under their own licences. Not for redistribution until the licence questions are settled: see docs/image-licences.md.",
          "licence_ids": [
            "nxp-firmware-imx",
            "gpl-kernel-bootloader",
            "alpine-packages"
          ],
          "runner": {
            "disk_gb": 20,
            "minutes": 45,
            "arch": "x86_64",
            "standard_runner": true,
            "needs": []
          }
        },
        "uuu": {
          "enabled": false,
          "disabled_reason": "The uuu step is being added to the board; enable when ./build.sh uuu lands and the file list below is confirmed.",
          "kind": "bundle",
          "stage": "uuu-bundle",
          "title": "uuu bundle: boot image, root filesystem, .uuu scripts (flash the on-module eMMC over USB)",
          "build": [
            "./build.sh --yes --accept-eula -r debian all"
          ],
          "bundle_files": [
            "imx-boot.bin",
            "rootfs.tar",
            "uuu-ram/*",
            "*.uuu"
          ],
          "bundle_readme": "README-uuu.txt",
          "deploy": [
            {
              "src": "@bundle",
              "name": "imx8mp-variscite-uuu.zip",
              "compress": "none",
              "role": "bundle"
            }
          ],
          "approx_size_mb": 500,
          "approx_raw_size_mb": 1200,
          "size_is_estimate": true,
          "redistribution": "Same third-party content as the SD-card images (NXP DDR firmware inside imx-boot.bin, kernel, Debian packages). Not for redistribution until the licence questions are settled.",
          "licence_ids": [
            "nxp-firmware-imx",
            "gpl-kernel-bootloader",
            "debian-packages"
          ],
          "runner": {
            "disk_gb": 25,
            "minutes": 60,
            "arch": "x86_64",
            "standard_runner": true,
            "needs": [
              "qemu-user-static",
              "user namespaces"
            ]
          },
          "verified_on_hardware": false,
          "verified_note": "the uuu flow itself has not been run on a board yet; the SD-card images of this board are the verified ones"
        }
      },
      "verified_on_hardware": true,
      "verified_note": "VAR-SOM-MX8M-PLUS on Symphony"
    },
